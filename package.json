{
  "name": "@saranyaskumar/contextkit",
  "version": "0.2.0",
  "description": "A lightweight, provider-independent context selection toolkit for AI agents",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --import tsx --test tests/*.test.ts",
