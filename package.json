{
  "name": "@saranyaskumar/contextkit",
  "version": "0.3.1",
  "description": "A lightweight, provider-independent context selection toolkit for AI agents",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "demo": "tsx src/demo.ts",
    "benchmark": "npm run build && node dist/benchmark.js",
    "check": "npm run build && npm test",
    "evaluate:lexical": "npm run build && node dist/evaluate-lexical.js",
    "evaluate:real": "npm run build && node dist/evaluate-real.js",
    "evaluate:local": "npm run build && node dist/evaluate-local.js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "license": "MIT"
}
